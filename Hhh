
function Ainv = myinv(A)
% Calculate inverse or pseudo-inverse from scratch
% Without using inv() or pinv()

    if isempty(A) || ~isnumeric(A) || ~ismatrix(A)
        error('Input must be a non-empty numeric matrix.');
    end

    [n, m] = size(A);

    if n == m
        % Square matrix
        Ainv = gaussJordan(A);

    elseif n > m
        % More rows than columns
        % Pseudo-inverse: (A' * A)^(-1) * A'
        Ainv = gaussJordan(A' * A) * A';

    else
        % More columns than rows
        % Pseudo-inverse: A' * (A * A')^(-1)
        Ainv = A' * gaussJordan(A * A');
    end
end


function B = gaussJordan(A)

    n = size(A, 1);

    tol = 1e-12 * max(1, norm(A, inf));

    M = [A, eye(n)];

    for i = 1:n

        % Partial pivoting
        [~, k] = max(abs(M(i:n, i)));
        k = k + i - 1;

        if abs(M(k, i)) < tol
            error('Matrix is singular or nearly singular.');
        end

        % Swap rows
        M([i k], :) = M([k i], :);

        % Normalize pivot row
        M(i, :) = M(i, :) / M(i, i);

        % Eliminate other rows
        for j = 1:n
            if j ~= i
                M(j, :) = M(j, :) - M(j, i) * M(i, :);
            end
        end
    end

    % Extract inverse
    B = M(:, n+1:2*n);

end
