
% Standard Doolittle's LU Decomposition

A = [2, -1, -2;
    -4, 6, 3;
    -4, -2, 8];

n = size(A, 1);

L = eye(n);  % Lower matrix with 1s on diagonal
U = A;       % Copy of A

for k = 1:n-1
    for i = k+1:n
        L(i, k) = U(i, k) / U(k, k);  % Save multiplier in L
        U(i, k:n) = U(i, k:n) - L(i, k) * U(k, k:n); % Eliminate below pivot
    end
end

disp('Matrix L:');
disp(L);

disp('Matrix U:');
disp(U);

